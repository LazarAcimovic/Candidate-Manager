# Root env file for the Docker Compose stack. Copy to `.env`; Compose reads
# it automatically. Values here are the local defaults (see docs/Tech.md §5).

# Backend container reaches Postgres at host `db` inside the compose network.
DB_URL=jdbc:postgresql://db:5432/hr_platform
DB_USERNAME=postgres
DB_PASSWORD=postgres
SERVER_PORT=8793
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Frontend (Vite, build-time) — documented here for completeness; the
# frontend is run separately with `npm run dev`.
VITE_API_BASE_URL=http://localhost:8793
